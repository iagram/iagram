{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iagram.dev/schemas/catalog-entry.json",
  "title": "iagram catalog entry",
  "description": "One drawable element. Path must be catalog/<provider>/<name>.yaml and id must be <provider>.<name>.",
  "type": "object",
  "required": ["id", "label", "category", "kind", "allowed_parents"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9_]+$"},
    "label": {"type": "string"},
    "description": {"type": "string"},
    "category": {"type": "string", "enum": ["account", "network", "compute", "database", "storage", "security", "serverless", "integration"]},
    "icon": {"type": "string", "description": "Path under catalog/icons/, e.g. aws/ec2.svg"},
    "icon_variants": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Alternative icons keyed by a boolean property name; used when that property is true."},
    "kind": {"type": "string", "enum": ["leaf", "container"]},
    "allowed_parents": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Catalog ids this element may be dropped into; 'root' means directly on the canvas."},
    "allowed_children": {"type": "array", "items": {"type": "string"}, "description": "Optional whitelist for containers; when omitted, children are governed by their own allowed_parents."},
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in": {"type": "array", "items": {"$ref": "#/$defs/rule_in"}},
        "out": {"type": "array", "items": {"$ref": "#/$defs/rule_out"}}
      }
    },
    "props": {"type": "object", "description": "JSON Schema (object) for the element's properties; drives the property panel and validation."},
    "terraform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "enum": ["module", "account", "region", "resource"], "description": "module (default) emits a module block per node; account/region configure the provider."},
        "module": {"type": "string", "description": "Module path under modules/, e.g. aws/ec2_instance. Required for role module."},
        "import": {"type": "object", "additionalProperties": false, "properties": {"resource": {"type": "string"}, "props": {"type": "object", "additionalProperties": {"type": "string"}}, "parent": {"type": "string"}, "id": {"type": "string"}, "name": {"type": "string"}, "from": {"type": "string"}, "prop": {"type": "string"}}, "description": "How to recognise this element in an existing Terraform state (iagram import)."},
        "provider_args": {"type": "object", "description": "Roles account/region: template for the provider block; \"${prop}\" strings are replaced by node properties, empty ones dropped."},
        "inputs_from_parent": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^\\[?parent(\\.parent)*\\.[a-z0-9_]+\\]?$"}, "description": "input -> ancestor output reference, e.g. parent.vpc_id; wrap in [] to pass a one-element list (empty when the ancestor is not a module) so modules can branch on length()"},
        "collect": {"type": "object", "additionalProperties": {"type": "object", "required": ["type", "under", "output"], "additionalProperties": false, "properties": {"type": {"type": "string"}, "under": {"type": "string", "pattern": "^parent(\\.parent)*$"}, "output": {"type": "string"}, "min": {"type": "integer", "minimum": 0, "description": "Minimum number of gathered nodes for the element to be valid."}, "distinct": {"type": "string", "description": "Property that must differ across at least min gathered nodes."}}}}
      }
    },
    "outputs": {"type": "array", "items": {"type": "string"}},
    "size": {"type": "object", "required": ["w", "h"], "properties": {"w": {"type": "number"}, "h": {"type": "number"}}}
  },
  "$defs": {
    "rule_tf":  {"type": "object", "required": ["set", "input", "value"], "additionalProperties": false, "properties": {"set": {"type": "string", "enum": ["from", "to"]}, "input": {"type": "string"}, "value": {"type": "string", "pattern": "^(from|to)\\.[a-z0-9_]+$"}}},
    "rule_in":  {"type": "object", "required": ["from", "kind"], "additionalProperties": false, "properties": {"from": {"type": "string"}, "kind": {"type": "string"}, "label": {"type": "string"}, "terraform": {"$ref": "#/$defs/rule_tf"}, "requires_from": {"type": "object"}, "requires_to": {"type": "object"}}},
    "rule_out": {"type": "object", "required": ["to", "kind"],   "additionalProperties": false, "properties": {"to": {"type": "string"},   "kind": {"type": "string"}, "label": {"type": "string"}, "terraform": {"$ref": "#/$defs/rule_tf"}, "requires_from": {"type": "object"}, "requires_to": {"type": "object"}}}
  }
}
