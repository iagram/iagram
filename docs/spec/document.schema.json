{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iagram.dev/schemas/document-v1.json",
  "title": "iagram document v1",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "name": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "props", "layout"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "pattern": "^[a-z0-9]+\\.[a-z0-9_]+$"},
          "name": {"type": "string"},
          "parent": {"type": "string"},
          "props": {"type": "object"},
          "outputs": {"type": "object", "description": "Written by iagram apply from module outputs; informational."},
          "layout": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number"}, "h": {"type": "number"}}
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source", "target"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "attr": {"type": "string", "description": "references edges: the source attribute that receives the reference"},
          "output": {"type": "string", "description": "references edges: the target attribute or output referenced (default id)"}
        }
      }
    }
  }
}
