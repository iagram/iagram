{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iagram.dev/schemas/document-v1.json",
  "title": "iagram document v1",
  "type": "object",
  "required": [
    "version",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name",
          "props",
          "layout"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9]+\\.[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "props": {
            "type": "object"
          },
          "outputs": {
            "type": "object",
            "description": "Written by iagram apply from module outputs; informational."
          },
          "layout": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              },
              "z": {
                "type": "integer",
                "description": "stacking order among siblings; higher is in front"
              }
            }
          },
          "caption": {
            "type": "string",
            "description": "free second line under the name; informational"
          },
          "step": {
            "type": "string",
            "description": "callout number of the walkthrough (\"1\", \"9a\"); informational"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "attr": {
            "type": "string",
            "description": "references edges: the source attribute that receives the reference"
          },
          "output": {
            "type": "string",
            "description": "references edges: the target attribute or output referenced (default id)"
          },
          "label": {
            "type": "string",
            "description": "overrides the kind's label; informational"
          },
          "step": {
            "type": "string",
            "description": "callout number of the walkthrough; informational"
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "direction": {
                "type": "string",
                "enum": [
                  "one",
                  "both",
                  "none"
                ]
              },
              "dash": {
                "type": "string",
                "enum": [
                  "solid",
                  "dashed",
                  "dotted"
                ]
              },
              "color": {
                "type": "string"
              },
              "inactive": {
                "type": "boolean"
              }
            },
            "description": "how the arrow is drawn; informational"
          },
          "type": {
            "type": "string",
            "description": "link edges: the link element (<provider>.res.<terraform type>) this line creates"
          },
          "name": {
            "type": "string",
            "description": "link edges: Terraform resource name"
          },
          "props": {
            "type": "object",
            "description": "link edges: attributes besides the two ends"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "numbered walkthrough text; informational"
    }
  }
}
